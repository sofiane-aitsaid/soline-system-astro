---
import { f } from '../lib/content';
const d = f('methode');
const steps = d.steps ?? [];
---
<section id="methode" class="section">
  <div class="container">
    <header class="head">
      {d.eyebrow && <p class="eyebrow">{d.eyebrow}</p>}
      {d.title && <h2>{d.title}</h2>}
    </header>
    <ol class="grid-3 steps">
      {steps.map((s: any, i: number) => (
        <li class="card step">
          <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; padding: 0; margin: 0; counter-reset: none; }
  .step { padding: 26px; background: #fff; position: relative; }
  .n { font-family: var(--font-display); font-weight: 800; font-size: 3rem; line-height: 1; color: var(--accent); -webkit-text-stroke: 2px var(--ink); display: block; margin-bottom: 14px; }
  .step h3 { font-size: 1.3rem; margin: 0 0 8px; }
  .step p { margin: 0; color: var(--muted); }
  @media (min-width: 901px) {
    .step:not(:last-child)::after { content: '→'; position: absolute; left: 100%; width: 24px; text-align: center; top: 50%; transform: translateY(-50%); font-size: 1.6rem; font-weight: 800; z-index: 1; }
  }
</style>
