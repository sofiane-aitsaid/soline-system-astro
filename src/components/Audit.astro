---
import { f } from '../lib/content';
const d = f('audit');
---
<section id="audit" class="section">
  <div class="container">
    <div class="card audit">
      <div>
        {d.eyebrow && <p class="eyebrow">{d.eyebrow}</p>}
        {d.title && <h2>{d.title}</h2>}
        {d.text && <p class="lead">{d.text}</p>}
      </div>
      {d.cta && <a class="btn btn-dark" href="#rdv">{d.cta}</a>}
    </div>
  </div>
</section>

<style>
  .audit { background: var(--pop); padding: 44px; display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; }
  .audit .eyebrow { background: #fff; }
  .audit h2 { margin: 14px 0 12px; max-width: 18em; }
  .audit .lead { margin: 0; color: var(--ink); }
  @media (max-width: 800px) { .audit { grid-template-columns: 1fr; padding: 26px; } }
</style>
