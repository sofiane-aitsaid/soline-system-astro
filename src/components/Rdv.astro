---
import { f, calUrl } from '../lib/content';
const d = f('rdv');
---
<section id="rdv" class="section">
  <div class="container">
    <div class="card rdv">
      {d.title && <h2>{d.title}</h2>}
      {d.text && <p class="lead">{d.text}</p>}
      {d.cta && <a class="btn btn-pop" href={calUrl} target="_blank" rel="noopener">{d.cta}</a>}
    </div>
  </div>
</section>

<style>
  .rdv { background: var(--accent); color: #fff; text-align: center; padding: 64px 28px; display: grid; justify-items: center; gap: 4px; }
  .rdv h2 { margin: 0 0 12px; }
  .rdv .lead { color: rgb(255 255 255 / 0.88); max-width: 34em; margin: 0 0 28px; }
</style>
