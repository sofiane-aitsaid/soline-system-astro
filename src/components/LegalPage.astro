---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Txt from './Txt.astro';
import { brand, ui, vars } from '../lib/content';

type Page = { title: string; intro?: string; updated?: string; sections: { title: string; items: string[] }[] };
const { page } = Astro.props as { page: Page };
---
<Layout title={`${page.title} · ${brand.name}`} description={page.intro}>
  <Nav base="/" />
  <main class="legal">
    <div class="container narrow">
      <a class="back" href="/">{ui.backHome}</a>
      <h1>{page.title}</h1>
      {page.intro && <p class="lead">{page.intro}</p>}
      {page.sections.map((s) => (
        <section class="card block">
          <h2>{s.title}</h2>
          {s.items.map((it) => <p><Txt text={vars(it)} /></p>)}
        </section>
      ))}
      {page.updated && <p class="updated"><Txt text={page.updated} /></p>}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal { padding: calc(var(--nav-h) + 48px) 0 80px; }
  .narrow { max-width: 820px; }
  .back { display: inline-block; font-weight: 700; margin-bottom: 20px; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 0 0 14px; }
  .lead { margin-bottom: 36px; }
  .block { background: #fff; padding: 24px 26px; margin-bottom: 20px; box-shadow: 4px 4px 0 var(--ink); }
  .block h2 { font-size: 1.35rem; margin: 0 0 10px; }
  .block p { margin: 0 0 8px; color: var(--muted); overflow-wrap: anywhere; }
  .updated { color: var(--muted); font-size: 0.9rem; }
</style>
