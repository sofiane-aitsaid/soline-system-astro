---
import Txt from './Txt.astro';
import { brand, f, fill, ui } from '../lib/content';
const d = f('footer');
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container foot-grid">
    <div>
      <p class="name">{brand.name}</p>
      {d.tagline?.trim() && <p class="muted">{d.tagline.trim()}</p>}
    </div>
    <ul class="contact">
      {d.email && <li><a href={`mailto:${d.email}`}>{d.email}</a></li>}
      {d.phone && <li><a href={`tel:${d.phone.replace(/\s+/g, '')}`}>{d.phone}</a></li>}
      {fill(d.address) && <li>{fill(d.address)}</li>}
      <li>{ui.siretLabel} : <Txt text={fill(d.siret)} /></li>
    </ul>
    <ul class="legal">
      {ui.legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
  <div class="container copy">© {year} {brand.name}</div>
</footer>

<style>
  .footer { border-top: 2px solid var(--ink); background: #fff; padding: 48px 0 24px; }
  .foot-grid { display: grid; grid-template-columns: 1.2fr 1fr auto; gap: 32px; }
  .name { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; margin: 0 0 6px; }
  .muted { color: var(--muted); margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  a { color: var(--ink); font-weight: 600; }
  .copy { margin-top: 36px; padding-top: 18px; border-top: 1px dashed rgb(18 22 28 / 0.25); font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 800px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
