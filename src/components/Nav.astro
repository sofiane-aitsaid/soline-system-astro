---
import { brand, f, ui, isVisible, calUrl } from '../lib/content';
const { base = '' } = Astro.props as { base?: string };
const d = f('nav');
const links = (d.links ?? [])
  .map((label: string, i: number) => ({ label, id: ui.navTargets[i] }))
  .filter((l: { id?: string }) => l.id && isVisible(l.id));
---
<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href={base || '#hero'} aria-label={`${brand.name} · ${ui.homeLabel}`}>
      <span class="logo-mark" aria-hidden="true"></span>
      <span>{brand.name}</span>
    </a>
    <nav class="nav-links flowline">
      <span class="rail" aria-hidden="true"><span class="fill"></span><span class="packet"></span></span>
      {links.map((l: any) => <a class="node" data-target={l.id} href={`${base}#${l.id}`}><span class="port" aria-hidden="true"></span>{l.label}</a>)}
    </nav>
    {d.cta && <a class="btn btn-primary btn-sm nav-cta" href={calUrl} target="_blank" rel="noopener">{d.cta}</a>}
    <details class="nav-mobile">
      <summary aria-label={ui.menuLabel}>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
      </summary>
      <div class="nav-panel card">
        <div class="vflow">
          {links.map((l: any) => <a class="node" data-target={l.id} href={`${base}#${l.id}`}><span class="port" aria-hidden="true"></span>{l.label}</a>)}
        </div>
        {d.cta && <a class="btn btn-primary" href={calUrl} target="_blank" rel="noopener">{d.cta}</a>}
      </div>
    </details>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; background: rgb(243 244 239 / 0.82); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 2px solid var(--ink); }
  .nav-inner { display: flex; align-items: center; gap: 24px; height: var(--nav-h); }
  .logo { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; color: var(--ink); text-decoration: none; letter-spacing: -0.02em; }
  .logo-mark { width: 26px; height: 26px; border-radius: 8px; background: var(--accent); border: 2px solid var(--ink); position: relative; box-shadow: 2px 2px 0 var(--ink); }
  .logo-mark::after { content: ''; position: absolute; inset: 5px; border-radius: 50%; background: var(--pop); border: 2px solid var(--ink); }
  /* Navigation en « ligne d'automatisation » : chaque lien est un nœud relié aux autres. */
  .flowline { position: relative; display: flex; align-items: center; gap: 20px; margin-left: auto; }
  .rail { position: absolute; left: 12px; right: 12px; top: 50%; height: 2px; transform: translateY(-50%); background: repeating-linear-gradient(90deg, var(--ink) 0 5px, transparent 5px 10px); z-index: 0; }
  .fill { position: absolute; left: 0; top: -1px; height: 4px; width: var(--fill, 0px); background: var(--accent); border-radius: 2px; transition: width 0.6s cubic-bezier(.3,.8,.3,1); }
  .packet { position: absolute; top: 50%; left: 0; width: 9px; height: 9px; margin-top: -4.5px; border-radius: 50%; background: var(--pop); border: 2px solid var(--ink); animation: packet 5s linear infinite; }
  @keyframes packet { from { left: 0; } to { left: calc(100% - 9px); } }
  .node { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px 5px 9px; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.88rem; white-space: nowrap; background: var(--bg); border: 2px solid var(--ink); border-radius: 999px; transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.3s ease; }
  .node:hover { transform: translateY(-2px); box-shadow: 2px 3px 0 var(--ink); }
  .port { position: relative; width: 9px; height: 9px; flex: none; border-radius: 50%; border: 2px solid var(--ink); background: #fff; transition: background-color 0.3s ease; }
  .node.is-done .port { background: var(--accent); }
  .node.is-active { background: var(--pop); box-shadow: 3px 3px 0 var(--ink); }
  .node.is-active .port { background: var(--accent); }
  .node.is-active .port::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 2px solid var(--accent); animation: port-ping 1.6s ease-out infinite; }
  @keyframes port-ping { from { opacity: 0.9; transform: scale(0.5); } to { opacity: 0; transform: scale(1.5); } }
  .nav-mobile { display: none; margin-left: auto; position: relative; }
  .nav-mobile summary { list-style: none; cursor: pointer; display: grid; place-items: center; width: 44px; height: 44px; border: 2px solid var(--ink); border-radius: 12px; background: #fff; box-shadow: 3px 3px 0 var(--ink); }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-panel { background: #fff; position: absolute; right: 0; top: 56px; width: min(280px, calc(100vw - 32px)); padding: 16px; display: grid; gap: 4px; }
  /* Version verticale de la ligne dans le menu mobile */
  .vflow { position: relative; display: grid; gap: 10px; padding: 4px 0 4px 2px; }
  .vflow::before { content: ''; position: absolute; left: 15px; top: 14px; bottom: 14px; border-left: 2px dashed var(--ink); }
  .vflow .node { justify-self: start; font-size: 0.95rem; padding: 7px 14px 7px 10px; }
  .nav-panel .btn { margin-top: 10px; }
  @media (max-width: 1100px) {
    .nav-links, .nav-cta { display: none; }
    .nav-mobile { display: block; }
  }
</style>

<script>
  // Suit la section visible : le nœud correspondant s'allume et la ligne se remplit jusqu'à lui.
  const nodes = [...document.querySelectorAll<HTMLAnchorElement>('.nav .node[data-target]')];
  const line = document.querySelector<HTMLElement>('.flowline');
  const ids = [...new Set(nodes.map((n) => n.dataset.target!))];
  const sections = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);

  if (line && sections.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const mark = window.innerHeight * 0.35;
      let current = -1;
      sections.forEach((sec, i) => { if (sec.getBoundingClientRect().top <= mark) current = i; });
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) current = sections.length - 1;
      const activeId = current >= 0 ? sections[current].id : null;
      const activeIdx = activeId ? ids.indexOf(activeId) : -1;
      nodes.forEach((n) => {
        const idx = ids.indexOf(n.dataset.target!);
        n.classList.toggle('is-active', idx === activeIdx);
        n.classList.toggle('is-done', activeIdx > -1 && idx < activeIdx);
        if (idx === activeIdx) n.setAttribute('aria-current', 'true'); else n.removeAttribute('aria-current');
      });
      const target = line.querySelector<HTMLElement>(`.node[data-target="${activeId}"]`);
      const rail = line.querySelector<HTMLElement>('.rail');
      const fill = target && rail ? target.offsetLeft + target.offsetWidth / 2 - rail.offsetLeft : 0;
      line.style.setProperty('--fill', `${Math.max(0, fill)}px`);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
